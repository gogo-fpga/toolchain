if(NOT CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR)
  return()
endif()

if(DEFINED WASI_OPT_FLAGS AND NOT WASI_OPT_FLAGS STREQUAL "")
  include("${CMAKE_CURRENT_LIST_DIR}/s5-wasi-opt-flags.cmake")
endif()

function(toolchain_prepare_nextpnr_unit relative_source patch_name)
  set(toolchain_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
  set(patch "${toolchain_root}/patches/nextpnr/${patch_name}")
  set(preparer "${toolchain_root}/scripts/prepare-pnr-source.py")
  get_filename_component(source_name "${relative_source}" NAME)
  set(patched_source "${CMAKE_BINARY_DIR}/patched/${source_name}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${patch}" "${preparer}" "${CMAKE_SOURCE_DIR}/${relative_source}")
  find_program(toolchain_python python3 REQUIRED)
  execute_process(
    COMMAND "${toolchain_python}" "${preparer}"
      --source "${CMAKE_SOURCE_DIR}/${relative_source}" --translation-unit "${relative_source}"
      --patch "${patch}" --output "${patched_source}"
    RESULT_VARIABLE patch_status
  )
  if(NOT patch_status EQUAL 0)
    message(FATAL_ERROR "Failed to prepare the nextpnr translation unit")
  endif()
endfunction()

function(toolchain_prepare_nextpnr_source)
  toolchain_prepare_nextpnr_unit("common/place/placer_heap.cc" "0002-stabilize-equal-coordinate-cuts.patch")
  toolchain_prepare_nextpnr_unit("himbaechel/uarch/gowin/globals.cc" "0004-stabilize-segment-grid-order.patch")
  set(patched_source "${CMAKE_BINARY_DIR}/patched/placer_heap.cc")
  if(NOT TARGET nextpnr-himbaechel-gowin-core OR NOT TARGET nextpnr_place)
    message(FATAL_ERROR "The expected nextpnr Gowin or placer target is missing")
  endif()
  get_target_property(original_sources nextpnr_place INTERFACE_SOURCES)
  set(patched_sources)
  set(replacements 0)
  foreach(source IN LISTS original_sources)
    if(source MATCHES "(^|/)common/place/placer_heap\\.cc$")
      list(APPEND patched_sources "${patched_source}")
      math(EXPR replacements "${replacements} + 1")
    else()
      list(APPEND patched_sources "${source}")
    endif()
  endforeach()
  if(NOT replacements EQUAL 1)
    message(FATAL_ERROR "Expected exactly one nextpnr heap placer translation unit")
  endif()
  set_property(TARGET nextpnr_place PROPERTY INTERFACE_SOURCES "${patched_sources}")
  set_property(SOURCE "${patched_source}" TARGET_DIRECTORY nextpnr-himbaechel-gowin
    APPEND PROPERTY COMPILE_DEFINITIONS EIGEN_DONT_VECTORIZE)
  set_property(SOURCE "${patched_source}" TARGET_DIRECTORY nextpnr-himbaechel-gowin
    APPEND PROPERTY COMPILE_OPTIONS -ffp-contract=off)
  get_target_property(original_sources nextpnr-himbaechel-gowin-core INTERFACE_SOURCES)
  set(patched_sources)
  set(replacements 0)
  set(patched_globals "${CMAKE_BINARY_DIR}/patched/globals.cc")
  foreach(source IN LISTS original_sources)
    if(source STREQUAL "${CMAKE_SOURCE_DIR}/himbaechel/uarch/gowin/globals.cc")
      list(APPEND patched_sources "${patched_globals}")
      math(EXPR replacements "${replacements} + 1")
    else()
      list(APPEND patched_sources "${source}")
    endif()
  endforeach()
  if(NOT replacements EQUAL 1)
    message(FATAL_ERROR "Expected exactly one nextpnr Gowin globals translation unit")
  endif()
  set_property(SOURCE "${patched_globals}" TARGET_DIRECTORY nextpnr-himbaechel-gowin PROPERTY INCLUDE_DIRECTORIES "${CMAKE_SOURCE_DIR}/himbaechel/uarch/gowin")
  set_property(TARGET nextpnr-himbaechel-gowin-core PROPERTY INTERFACE_SOURCES "${patched_sources}")
endfunction()

cmake_language(DEFER CALL toolchain_prepare_nextpnr_source)
