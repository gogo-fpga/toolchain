@@ -17,0 +18,126 @@
+#ifdef __EMSCRIPTEN__
+
+#include "util.h"
+#include "ident.h"
+#include "jit/jit-ffi.h"
+#include "jit/jit-priv.h"
+#include "jit/jit.h"
+#include "vlog/vlog-node.h"
+#include "vpi/vpi-model.h"
+
+#include <assert.h>
+#include <ctype.h>
+#include <string.h>
+
+struct _jit_dll {
+   int unused;
+};
+
+static jit_dll_t wasm_executable;
+
+ffi_uarray_t ffi_wrap(void *ptr, int64_t left, int64_t right)
+{
+   const int64_t length = right < left ? 0 : right - left + 1;
+   ffi_uarray_t u = {
+      .ptr = ptr,
+      .dims = { [0] = { .left = left, .length = length } }
+   };
+   return u;
+}
+
+void ffi_return_string(const char *str, jit_scalar_t *args, tlab_t *tlab)
+{
+   const size_t len = strlen(str);
+   void *mem = tlab_alloc(tlab, len);
+   memcpy(mem, str, len);
+   args[0].pointer = mem;
+   args[1].integer = 1;
+   args[2].integer = len;
+}
+
+bool ffi_is_integral(ffi_type_t type)
+{
+   return type == FFI_INT8 || type == FFI_INT16 || type == FFI_INT32
+      || type == FFI_INT64 || type == FFI_UINT8 || type == FFI_UINT16
+      || type == FFI_UINT32;
+}
+
+ffi_spec_t ffi_spec_new(const ffi_type_t *types, size_t count)
+{
+   assert(count > 0);
+   ffi_spec_t spec = {};
+   if (count < 7) {
+      memcpy(spec.embed, types, count);
+      spec.count = count;
+   }
+   else
+      spec.ext = types;
+   return spec;
+}
+
+jit_dll_t *ffi_load_dll(const char *path)
+{
+   if (path != NULL)
+      fatal("loading foreign libraries is not supported in this build");
+   return &wasm_executable;
+}
+
+void ffi_unload_dll(jit_dll_t *dll)
+{
+   (void)dll;
+}
+
+void *ffi_find_symbol(jit_dll_t *dll, const char *name)
+{
+   (void)dll;
+   if (name != NULL)
+      fatal("foreign subprogram calls are not supported in this build: %s",
+            name);
+   return NULL;
+}
+
+void jit_bind_foreign(jit_func_t *f, const uint8_t *spec, size_t length,
+                      tree_t where, tree_t region)
+{
+   (void)f;
+   (void)spec;
+   (void)length;
+   (void)where;
+   (void)region;
+   jit_msg(NULL, DIAG_FATAL,
+           "foreign subprogram calls are not supported in this build");
+}
+
+void jit_do_syscall(vlog_node_t where, jit_anchor_t *caller,
+                    jit_scalar_t *args, tlab_t *tlab)
+{
+   ident_t name = vlog_ident(where);
+   vpiHandle handle = vpi_bind_foreign(name, where);
+   if (handle == NULL)
+      jit_msg(NULL, DIAG_FATAL, "system task %s not registered", istr(name));
+   vpi_call_foreign(handle, args, tlab);
+   (void)caller;
+}
+
+void ffi_copy_closure(ffi_closure_t *dst, const ffi_closure_t *src)
+{
+   if (src == NULL) {
+      dst->handle = JIT_HANDLE_INVALID;
+      dst->nargs = 0;
+   }
+   else {
+      dst->handle = src->handle;
+      dst->nargs = src->nargs;
+      memcpy(dst->args, src->args, src->nargs * sizeof(jit_scalar_t));
+   }
+}
+
+size_t ffi_closure_size(const ffi_closure_t *c)
+{
+   if (c == NULL)
+      return 0;
+   return sizeof(ffi_closure_t) + (c->nargs - 1) * sizeof(jit_scalar_t);
+}
+
