	url = https://github.com/madler/zlib.git
	shallow = true
[submodule "vendor/emsdk"]
	path = vendor/emsdk
	url = https://github.com/emscripten-core/emsdk.git
	shallow = true
[submodule "vendor/yomiyasu"]
